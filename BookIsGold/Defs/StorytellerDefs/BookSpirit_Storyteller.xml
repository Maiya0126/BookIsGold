<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- 书灵纪：可选叙事者「砚翁与墨叽」 -->

	<StorytellerDef ParentName="BaseStoryteller">
		<defName>GoldenBooks_YanwengMoji</defName>
		<label>颜执中与颜知夏</label>
		<description>一老一少两位书灵（号砚翁、乳名墨叽）轮流执笔你的故事，并亲手安排你每天遇到的事件。\n\n【节奏】大威胁平均第 14 天才首次登门，此后约每 11~12 天一波——像卡珊德拉的阶梯曲线，但坡度更缓、喘息更长，符合砚翁"不为难学生"的教习作风；日常小事与奇遇的随机度接近兰迪·随机。\n\n【书灵私货】他们常"掉落"一箱书籍（约5天一次），书蠹也时不时光顾（约7天一次，剧情链解锁后）——这是他们夹带的小礼物，也是模组剧情事件的曝光口。\n\n他们会把殖民地的每一天写进《书语》。适合想要温和节奏、又能体验模组全剧情的玩家。</description>
		<portraitLarge>UI/HeroArt/Storytellers/GoldenBooks_YanwengMoji</portraitLarge>
		<portraitTiny>UI/HeroArt/Storytellers/GoldenBooks_YanwengMoji</portraitTiny>
		<listOrder>35</listOrder>
		<comps>
			<li Class="StorytellerCompProperties_ClassicIntro"/>
			<li Class="StorytellerCompProperties_OnOffCycle">
				<category>ThreatBig</category>
				<minDaysPassed>14</minDaysPassed>
				<onDays>4.2</onDays>
				<offDays>7.5</offDays>
				<minSpacingDays>2.2</minSpacingDays>
				<numIncidentsRange>1~1</numIncidentsRange>
				<forceRaidEnemyBeforeDaysPassed>24</forceRaidEnemyBeforeDaysPassed>
				<disallowedTargetTags>
					<li>Map_RaidBeacon</li>
				</disallowedTargetTags>
			</li>
			<li Class="StorytellerCompProperties_OnOffCycle">
				<category>ThreatSmall</category>
				<minDaysPassed>12</minDaysPassed>
				<onDays>4.2</onDays>
				<offDays>7.5</offDays>
				<numIncidentsRange>0.2~1</numIncidentsRange>
				<acceptPercentFactorPerThreatPointsCurve>
					<points>
						<li>(800, 1)</li>
						<li>(2800, 0)</li>
					</points>
				</acceptPercentFactorPerThreatPointsCurve>
			</li>
			<!-- 书灵私货：书箱与书蠹 -->
			<li Class="StorytellerCompProperties_CategoryMTB">
				<incident>GoldenBooks_LostBookBox</incident>
				<allowedTargetTags>
					<li>Map_PlayerHome</li>
				</allowedTargetTags>
				<minDaysPassed>3</minDaysPassed>
				<mtbDays>5</mtbDays>
			</li>
			<li Class="StorytellerCompProperties_CategoryMTB">
