<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- 书灵之书（殖民地书灵死亡掉落物，可召还） -->

	<ThingDef ParentName="ResourceBase">
		<defName>GoldenBooks_SpiritBook_Colonist</defName>
		<label>书灵之书</label>
		<description>化灵书灵化作的书册，浅金封面，写满他们自己名字的故事。\n\n书中之人并未消散——将其置于劝学台，辅以古籍残卷，即可召还。\n\n"自今日始，你亦是书中人。——砚翁"</description>
		<graphicData>
			<texPath>Things/Item/Book/TextBook</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<color>(150, 215, 195)</color>
			<drawSize>0.8</drawSize>
		</graphicData>
		<statBases>
			<MarketValue>2200</MarketValue>
			<Mass>0.5</Mass>
			<Beauty>3</Beauty>
		</statBases>
		<thingCategories>
			<li>Items</li>
		</thingCategories>
		<stackLimit>1</stackLimit>
		<tradeability>None</tradeability>
		<comps>
			<li Class="GoldenBooksMod.GoldenBooksCompProperties_SpiritBookData">
				<compClass>GoldenBooksMod.GoldenBooksComp_SpiritBookData</compClass>
			</li>
		</comps>
	</ThingDef>
</Defs>
