<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- 书灵物语：殖民地书灵——使用标准 Human 种族 -->
	<!-- 书灵特征通过 SpiritVitality hediff + BookSpirit comp 在生成后添加 -->

	<ThingDef ParentName="BasePawn">
		<defName>GoldenBooks_BookSpirit_Colonist</defName>
		<label>殖民地书灵</label>
		<description>由殖民地学者化灵而成的书灵。不食不眠，以读书人的心念为生。\n\n【光环·讲学】周围9.9格内殖民者：研究速度+15%、学习+20%、心情+3\n\n由「化灵之仪」诞生，死亡后化作书灵之书，可经劝学台召还。</description>
		<altitudeLayer>Pawn</altitudeLayer>
		<category>Pawn</category>
		<thingClass>Pawn</thingClass>
		<selectable>true</selectable>
		<hasTooltip>true</hasTooltip>
		<drawGUIOverlay>true</drawGUIOverlay>
		<drawHighlight>true</drawHighlight>
		<useHitPoints>false</useHitPoints>
		<tickerType>Normal</tickerType>
		<comps>
			<li>
				<compClass>CompAttachBase</compClass>
			</li>
		</comps>
		<inspectorTabs>
			<li>ITab_Pawn_Health</li>
			<li>ITab_Pawn_Needs</li>
			<li>ITab_Pawn_Character</li>
			<li>ITab_Pawn_Social</li>
			<li>ITab_Pawn_Gear</li>
			<li>ITab_Pawn_Log</li>
			<li>ITab_Pawn_FormingCaravan</li>
		</inspectorTabs>
		<race>
			<intelligence>Humanlike</intelligence>
			<renderTree>Humanlike</renderTree>
			<thinkTreeMain>Humanlike</thinkTreeMain>
			<thinkTreeConstant>HumanlikeConstant</thinkTreeConstant>
			<hasGenders>false</hasGenders>
			<makesFootprints>true</makesFootprints>
			<nameCategory>HumanStandard</nameCategory>
			<bloodDef>Filth_Blood</bloodDef>
			<body>Human</body>
			<baseBodySize>1</baseBodySize>
			<baseHungerRate>0.02</baseHungerRate>
			<baseHealthScale>1</baseHealthScale>
			<foodType>OmnivoreHuman</foodType>
			<lifeExpectancy>20</lifeExpectancy>
			<deathAction Class="DeathActionProperties_Vanish">
				<workerClass>DeathActionWorker_Vanish</workerClass>
			</deathAction>
			<lifeStageAges>
				<li>
					<def>HumanlikeAdult</def>
					<minAge>0</minAge>
				</li>
			</lifeStageAges>
		</race>
		<recipes>
			<li>Euthanize</li>
			<li>Anesthetize</li>
			<li>CureScaria</li>
		</recipes>
		<statBases>
			<Mass>60</Mass>
			<Flammability>0.7</Flammability>
			<ToxicResistance>1.0</ToxicResistance>
			<MoveSpeed>4.6</MoveSpeed>
			<MarketValue>8000</MarketValue>
			<ComfyTemperatureMin>-60</ComfyTemperatureMin>
			<ComfyTemperatureMax>45</ComfyTemperatureMax>
			<ArmorRating_Sharp>0.5</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.5</ArmorRating_Blunt>
			<ArmorRating_Heat>0.3</ArmorRating_Heat>
			<PainShockThreshold>0.9</PainShockThreshold>
		</statBases>
		<comps>
			<li Class="GoldenBooksMod.CompProperties_BookSpirit">
				<auraHediff>GoldenBooks_LectureAura</auraHediff>
				<waterHediff>GoldenBooks_SoakedBook</waterHediff>
			</li>
		</comps>
	</ThingDef>

	<PawnKindDef ParentName="Colonist">
		<defName>GoldenBooks_BookSpirit_Colonist_Kind</defName>
		<label>殖民地书灵</label>
		<race>GoldenBooks_BookSpirit_Colonist</race>
		<combatPower>70</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>Offworld</li>
				</categories>
			</li>
		</backstoryFilters>
	</PawnKindDef>
