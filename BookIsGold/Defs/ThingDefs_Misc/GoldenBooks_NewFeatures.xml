	<RecipeDef>
		<defName>GoldenBooks_Bind_FiveClassics</defName>
		<label>编纂：五经</label>
		<description>“男儿欲遂平生志，五经勤向窗前读。”\n\n将 5 份【古籍残卷】装订成册，编纂为一部完整的《五经》。\n\n【提示】古籍残卷通常源自于研读廉价书籍时的副产物。</description>
		<jobString>正在编纂：五经</jobString>
		<workSpeedStat>ResearchSpeed</workSpeedStat>
		<effectWorking>Research</effectWorking>
		<soundWorking>Recipe_Machining</soundWorking>
		<workAmount>500</workAmount>
		<recipeUsers>
			<li>GoldenBooks_ArcaneLectern</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
