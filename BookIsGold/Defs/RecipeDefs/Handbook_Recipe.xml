<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- 书灵物语：颜氏手札（内置小说阅读器）与装订配方 -->

	<ThingDef ParentName="ResourceBase">
		<defName>GoldenBooks_Handbook</defName>
		<label>颜氏手札</label>
		<description>颜氏一族千年间的手记，装订着糖纸、票根、金线与旧岁月。\n\n选中后点击「翻阅手札」按钮，可阅读《劝学诗里的千年灵》全书。\n\n【获取】课业「识字·开蒙」奖励解锁配方；或颜知夏乱入时赠予。</description>
		<graphicData>
			<texPath>Things/Item/Book/TextBook</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<color>(245, 235, 200)</color>
			<drawSize>0.8</drawSize>
			<color>(255, 235, 180)</color>
			<drawSize>0.8</drawSize>
		</graphicData>
		<statBases>
			<MarketValue>800</MarketValue>
			<Mass>0.5</Mass>
			<Beauty>4</Beauty>
		</statBases>
		<thingCategories>
			<li>Items</li>
		</thingCategories>
		<stackLimit>1</stackLimit>
		<tradeTags>
			<li>ExoticMisc</li>
		</tradeTags>
		<thingClass>GoldenBooksMod.HanbookItem</thingClass>
	</ThingDef>

	<RecipeDef>
		<defName>GoldenBooks_Bind_Handbook</defName>
		<label>装订：颜氏手札</label>
		<description>将 5 份古籍残卷以金线装订，复原颜氏一族的手札。装订完成后可随时翻阅书灵一族千年的故事。</description>
		<jobString>正在装订颜氏手札</jobString>
		<workSpeedStat>ResearchSpeed</workSpeedStat>
		<effectWorking>Research</effectWorking>
		<soundWorking>Recipe_Machining</soundWorking>
		<workAmount>800</workAmount>
		<recipeUsers>
			<li>GoldenBooks_ArcaneLectern</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>GoldenBooks_BookFragment</li>
					</thingDefs>
				</filter>
				<count>5</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>GoldenBooks_BookFragment</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<GoldenBooks_Handbook>1</GoldenBooks_Handbook>
		</products>
	</RecipeDef>
</Defs>
